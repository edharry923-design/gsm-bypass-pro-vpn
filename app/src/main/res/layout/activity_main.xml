<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Contenu Principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GSM BYPASS-PRO VPN"
            android:textColor="#00E676"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <!-- Choix du Protocole -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SÉLECTION DU PROTOCOLE :"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerProtocol"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="16dp" />

        <!-- Console de Logs -->
        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1E1E1E"
            android:textColor="#00E676"
            android:padding="12dp"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:layout_marginBottom="16dp" />

        <!-- Bouton de Connexion -->
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONNECTER"
            android:textStyle="bold"
            android:backgroundTint="#00E676"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

    <!-- Menu Latéral -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MENU GSM PRO"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/menuIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 Configuration IP / Payload"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuServers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔑 Importer Config (.gsm)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Paramètres Tunnel"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ À propos & Abonnement"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:padding="12dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
