<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Contenu Principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GSM BYPASS-PRO VPN"
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#1E1E1E"
            android:textColor="#00E676"
            android:padding="8dp"
            android:textSize="12sp"
            android:text="[System] Prêt à la connexion...\n"
            android:scrollbars="vertical"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONNECTER"
            android:backgroundTint="#00E676"
            android:textColor="#000000" />

    </LinearLayout>

    <!-- Menu Latéral (NavigationView / Drawer) -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MENU PRO"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/menuIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuration IP"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuServers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Serveurs VLess/VMess"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paramètres"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="À propos"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:padding="12dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
