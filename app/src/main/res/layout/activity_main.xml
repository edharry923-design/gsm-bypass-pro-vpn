<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="12dp">

    <!-- Carte supérieure : Paramètres et Champs de configuration -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <!-- Ligne d'état (Protocole • Mode • Routage) -->
        <TextView
            android:id="@+id/tvProtocolStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SSH • Performance Mode • Direct -> Target"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Champ Target -->
        <EditText
            android:id="@+id/etTargetServer"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:hint="target"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="8dp" />

        <!-- Champ Payload -->
        <EditText
            android:id="@+id/etPayload"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:color/transparent"
            android:hint="payload"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Bouton CONNECT couleur Lavande / Violet -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#B388FF"
        android:text="CONNECT"
        android:textColor="#121212"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="12dp" />

    <!-- Console de Logs (Terminal en direct avec infos de l'appareil) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#181818"
        android:padding="8dp">
        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
