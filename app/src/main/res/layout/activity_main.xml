<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <Spinner
        android:id="@+id/spinnerProtocol"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etTargetServer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:hint="Serveur cible : Port"
        android:padding="10dp"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etUuid"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:hint="UUID / Mot de passe / Utilisateur"
        android:padding="10dp"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etPayload"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:hint="Payload / SNI / Chemin WebSocket"
        android:padding="10dp"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#00838F"
        android:text="Démarrer"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E1E1E"
        android:padding="8dp">
        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[System] Prêt...\n"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
